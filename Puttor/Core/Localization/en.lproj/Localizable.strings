/* Games — goals */
"game.gate.goal" = "Control your start line and a clean, straight stroke without twisting the putter face.";
"game.clock.goal" = "Practise different breaks from the same distance without your feel for length changing.";
"game.ninePutt.goal" = "Build consistency under light pressure and lock down short-to-mid putts.";
"game.routine.goal" = "Simulates real on-course situations and trains your routine and focus on every single, different putt.";
"game.aroundTheWorld.goal" = "Simulates a complete round and shows you where your weaknesses still are.";

/* Games — full explanations */
"game.gate.explanation" = "Push two tees into the ground just in front of the ball, spaced just wide enough for the putter head/ball to pass through (a \"gate\"). Then putt through this gate toward your target line.";
"game.clock.explanation" = "Place balls in a circle around the hole, like numbers on a clock face (e.g. 12, 3, 6 and 9 o'clock), all at the same distance. Then putt each ball in turn — working your way around clockwise.";
"game.ninePutt.explanation" = "Choose three positions at different distances (e.g. 1 m, 2 m, 3 m) and putt 3 balls from each — 9 putts total. All 9 must go in, or you start over from the beginning.";
"game.routine.explanation" = "Randomly prescribed putts — choose which distances and break ranges should be possible. Play these putts one after another exactly as given, each with your full pre-shot routine, no practice putts or do-overs.";
"game.aroundTheWorld.explanation" = "Build a course of 9 or 18 different putts on the green and play them like a mini round — each putt counts as a hole. Track your strokes per \"hole\" and add them up at the end.";

