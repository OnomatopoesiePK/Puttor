"tip.moreBreak.title" = "경사를 더 보세요";
"tip.moreBreak.body" = "%@ 공이 홀 아래쪽으로 너무 자주 멈춥니다. 라인의 가장 높은 지점을 고르고, 애매하면 경사를 더 보세요, 위쪽에서는 공이 아직 떨어질 수 있습니다.";
"tip.lessBreak.title" = "경사를 덜 보세요";
"tip.lessBreak.body" = "%@ 공이 계속 홀 위쪽으로 지나갑니다. 더 타이트한 라인을 잡고, 공이 경사를 다 타지 않을 만큼의 속도로 치세요.";
"tip.phantomBreak.title" = "직선 퍼트는 직선으로";
"tip.phantomBreak.body" = "%@ 없는 경사를 보고 있습니다. 뚜렷한 경사가 보이지 않으면 홀 한가운데를 겨냥하고 직선 읽기를 믿으세요.";
"tip.uphillPace.title" = "오르막에서는 과감하게";
"tip.uphillPace.body" = "%@ 공이 짧게 멈춥니다. 홀 30~50 cm 뒤에 목표를 그리고, 그만큼 백스윙을 길게 하세요.";
"tip.downhillPace.title" = "내리막에서는 부드럽게";
"tip.downhillPace.body" = "%@ 공이 너무 멀리 굴러갑니다. 실제 홀보다 50 cm 앞에 홀이 있다고 그리고, 공이 그 안으로 굴러 들어가게 하세요.";
"tip.slopeOverRead.title" = "경사를 과하게 보지 마세요";
"tip.slopeOverRead.body" = "%@ 실제보다 경사를 많이 봅니다. 같은 길이의 평지 퍼트 속도에서 출발해 아주 조금만 조정하세요.";
"tip.dieAtHole.title" = "공을 홀까지 보내세요";
"tip.dieAtHole.body" = "%@ 미스가 짧게 멈춥니다. 공이 홀 30~40 cm 뒤에 서도록 치세요, 짧으면 절대 들어가지 않습니다.";
"tip.softerPace.title" = "속도를 조금 줄이세요";
"tip.softerPace.body" = "%@ 미스가 너무 멀리 갑니다. 길이는 때리는 힘이 아니라 백스윙의 크기로 맞추고, 공이 홀 가장자리에서 힘을 잃는 모습을 그리세요.";
"tip.startLineLeft.title" = "출발선: 왼쪽은 아닙니다";
"tip.startLineLeft.body" = "%@ 미스가 왼쪽으로 갑니다. 공 앞 30 cm 지점을 고르고, 페이스를 그곳에 맞춘 뒤 그 위로 공을 굴리세요.";
"tip.startLineRight.title" = "출발선: 오른쪽은 아닙니다";
"tip.startLineRight.body" = "%@ 미스가 오른쪽으로 갑니다. 공 앞 30 cm 지점을 고르고, 페이스를 그곳에 맞춘 뒤 그 위로 공을 굴리세요.";
"tip.pull.title" = "당겨치기를 멈추세요";
"tip.pull.body" = "%@ 퍼트를 왼쪽으로 당깁니다. 어깨가 스트로크를 이끌게 하고, 손목은 고정하고, 임팩트 이후까지 머리를 두세요.";
"tip.push.title" = "밀어치기를 멈추세요";
"tip.push.body" = "%@ 퍼트를 오른쪽으로 밉니다. 퍼터를 라인 위로 끌고 가지 말고 공을 지나 자유롭게 지나가게 하며, 페이스를 스퀘어로 유지하세요.";
"tip.contact.title" = "깨끗하게 맞히세요";
"tip.contact.body" = "%@ 공이 깨끗하게 맞지 않습니다. 공을 페이스 한가운데 앞에 놓고, 스트로크 내내 퍼터 높이를 일정하게 유지하세요.";
"tip.badStroke.title" = "더 차분한 스트로크로";
"tip.badStroke.body" = "%@ 스트로크 자체가 퍼트를 잃게 합니다. 백스윙과 팔로스루를 같은 리듬으로 하고, 임팩트 이후까지 공 위에서 움직이지 마세요.";
"tip.readTime.title" = "더 꼼꼼하게 읽으세요";
"tip.readTime.body" = "%@ 라인을 자주 잘못 읽습니다. 결정하기 전에 뒤에서, 그리고 낮은 쪽에서 읽고, 그다음에는 자기 읽기를 믿으세요.";
"tip.aim.title" = "조준을 확인하세요";
"tip.aim.body" = "%@ 자주 라인 밖을 겨냥합니다. 공의 선을 목표에 맞추고, 어드레스 전에 뒤에서 확인하세요.";
"tip.holedLess.title" = "이런 조건에서는 시간을 더 쓰세요";
"tip.holedLess.body" = "%@ 퍼트가 눈에 띄게 덜 들어갑니다. 읽기와 루틴에 시간을 들이고, 서두르지 마세요.";
"tip.lag.title" = "긴 퍼트를 붙이세요";
"tip.lag.body" = "%@ 3퍼트가 더 자주 나옵니다. 첫 퍼트에서는 라인보다 길이가 중요합니다, 홀 주위 1 m 원을 목표로 하세요.";
"tip.lagDistance.title" = "롱퍼트 거리감을 다듬으세요";
"tip.lagDistance.body" = "%@ 너무 많은 퍼트가 홀에서 1 m 넘게 떨어져 멈춥니다. 첫 퍼트는 길이에 집중하고, 홀 주위 1 m 원을 목표로 하세요.";
