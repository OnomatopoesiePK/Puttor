"coach.reason.weakDistance" = "Entrena la distancia en la que estás más flojo, alrededor de %@.";
"coach.reason.lowSide" = "Tus putts con caída siguen fallando por el lado bajo: este ejercicio son cuatro putts con caída y uno recto.";
"coach.reason.startLine" = "Tus putts cortos se van siempre hacia el mismo lado, y eso es la línea de salida.";
"coach.reason.straightLine" = "Incluso tus putts rectos fallan siempre por el mismo lado, y eso es la línea de salida.";
"coach.reason.breakSide" = "Con una caída concreta tus fallos se van siempre al mismo lado: este ejercicio tiene putts con caída hacia ambos lados.";
