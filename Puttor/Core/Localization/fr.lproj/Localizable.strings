"tutorial.welcome" = "Bienvenue dans Puttor ! Préparons et jouons votre premier parcours ensemble. Cela ne prend que quelques minutes.";
"tutorial.courseName" = "Ici, vous pouvez indiquer le nom du parcours que vous jouez. Si vous ne jouez que 9 trous, un astérisque est ajouté au nom, et pour un tournoi, la mention %@ est ajoutée.";
"tutorial.courseName.hint" = "Touchez le champ, saisissez un nom et validez avec Terminé.";
"tutorial.putter" = "Ajoutez le putter avec lequel vous jouez. Plus tard, vous pourrez comparer vos statistiques putter par putter.";
"tutorial.greenSpeed" = "Réglez la vitesse des greens du jour. Elle est donnée en Stimp, plus le chiffre est élevé, plus le green est rapide. Elle est enregistrée avec le parcours, vous pourrez donc comparer plus tard votre putting sur greens rapides et lents.";
"tutorial.weather" = "Indiquez le temps qu'il fait pendant votre partie. Vous pourrez filtrer vos statistiques là-dessus plus tard.";
"tutorial.format" = "%1$@ (ou une partie en Stableford) est le mode standard. Choisissez %2$@ quand vous jouez trou par trou contre quelqu'un.";
"tutorial.inputModes" = "Choisissez ce que vous voulez enregistrer :\n\n• %1$@ enregistre tout : pente, angle du manqué et causes du manqué.\n• %2$@ enregistre la distance, le « putt pour » (birdie, par, …) et rentré ou manqué. Peu de données entrent dans les statistiques dans ce mode.\n• Dans %3$@, vous ajoutez les champs que vous voulez et réglez leur niveau de détail.\n\nVotre premier parcours se joue en %1$@.";
"tutorial.startRound" = "Tout est prêt ! Touchez %@ pour commencer.";
"tutorial.distance" = "Saisissez ici la distance du putt au trou. Le chiffre par défaut se règle dans les Réglages. Quand le chiffre du champ est net, la saisie est enregistrée et vous pouvez taper un nouveau nombre SANS effacer l'ancien. ATTENTION : un chiffre pâle n'est pas encore enregistré, pour le valider il faut toujours appuyer sur %@.";
"tutorial.pace" = "Astuce : vous ne savez pas à quoi ressemble un mètre ? Arpentez une longueur connue et soit ajustez votre pas pour qu'il fasse un mètre, soit retenez simplement la longueur de votre pas et convertissez. En général, un pas un peu allongé fait à peu près un mètre.";
"tutorial.pace.imperial" = "Astuce : vous ne savez pas à quoi ressemblent 3 pieds ? Arpentez une longueur connue et soit ajustez votre pas pour qu'il fasse un yard (3 pieds), soit retenez simplement la longueur de votre pas et convertissez. En général, un pas un peu allongé fait à peu près un yard.";
"tutorial.puttFor" = "Choisissez ici, sous « putt pour » (birdie, par, …), le score que vous visez avec ce putt. Ne l'oubliez pas, cela peut créer de la confusion plus tard.";
"tutorial.slope" = "Touchez la case qui correspond à la pente de votre putt. Le putt réglé ici descend de 3%% et tourne de 2%% de gauche à droite. Essayez de trouver votre pente. Le putt droit se trouve au centre, à 0. Le mode Perso propose aussi d'autres façons de la saisir, et il existe des jeux pour mieux lire les greens.";
"tutorial.missAngle" = "Manqué ? Ce qui compte, c'est l'endroit où la balle est passée près du trou, pas là où elle s'est arrêtée. Si la balle passe à gauche puis tourne à droite après le trou, vous marquez à gauche. L'angle relève de votre jugement, mais le mieux est d'imaginer où le manqué aurait fini sur un putt droit. Dans l'exemple, la balle a fait un lip-out sur le bord gauche du trou. Elle est marquée en conséquence.";
"tutorial.missAngleDetail" = "Faites glisser l'anneau vous-même pour régler l'angle exact. La distance à laquelle la balle s'est arrêtée ne se saisit pas ici, elle vient avec le putt suivant. Le centre est le putt rentré, l'anneau autour un lip-out.\n\nLe mieux est d'imaginer le putt tiré droit et de marquer le manqué ainsi.";
"tutorial.missAngleDetail.hint" = "Marquez d'abord un résultat : le centre, le bord ou un point sur l'anneau.";
"tutorial.missReasons" = "Si vous savez pourquoi le putt est manqué, marquez-le ici. Ce n'est pas obligatoire, mais c'est possible.";
"tutorial.record" = "Touchez %1$@ une fois les champs ci-dessus remplis et un résultat saisi. Si la balle n'est qu'à quelques centimètres du trou, sautez toute la saisie et appuyez simplement sur %2$@ : le putt est compté depuis %3$@ et comme rentré. Dès que le putt est terminé, on passe automatiquement au putt suivant ou au trou suivant.";
"tutorial.tryRest" = "À vous maintenant : saisissez le reste de ce trou vous-même. Le putt suivant part de là où la balle s'est arrêtée, et la distance par défaut est %@.";
"tutorial.pickUp" = "Si vous relevez votre balle, vous pouvez le noter avec ce symbole. C'est vous qui décidez si vous inscrivez un score, et lequel.";
"tutorial.holePicker" = "Touchez le numéro du trou en haut à gauche pour sauter à n'importe quel autre trou.";
"tutorial.navArrows" = "Les flèches vous font passer d'un trou à l'autre.";
"tutorial.puttChips" = "Ici en haut, vous voyez chaque putt du trou où vous êtes. S'il y en a plusieurs, touchez-en un pour le consulter ou le modifier.";
"tutorial.endRound" = "Touchez %@ en haut à droite pour terminer le parcours. La corbeille supprime tous les putts d'un trou. Vous ne pouvez rien casser, alors essayez tous les boutons, car là où cela compte, Puttor vous redemande de toute façon.";
"tutorial.editLater" = "Même après le parcours, vous pouvez encore modifier vos putts et changer des saisies : ouvrez le parcours sous « Derniers parcours » et touchez « %@ » sur le trou.";
"tutorial.settings" = "Dans les Réglages, vous choisissez les unités, la langue et la distance de départ d'un putt, vous configurez les champs du mode Perso et bien plus.";
"tutorial.finish" = "C'est tout ! Essayez tout, et tournez aussi votre téléphone : le mode paysage apporte des fonctions et des mises en page supplémentaires. Bon parcours !";
