"tip.moreBreak.title" = "Jouez plus de pente";
"tip.moreBreak.body" = "%@ la balle reste trop souvent sous le trou. Choisissez le point haut de la ligne et, dans le doute, jouez plus de pente, par le haut la balle peut encore tomber.";
"tip.lessBreak.title" = "Jouez moins de pente";
"tip.lessBreak.body" = "%@ la balle passe sans cesse au-dessus du trou. Jouez une ligne plus serrée avec assez de vitesse pour que la balle ne prenne pas toute la pente.";
"tip.phantomBreak.title" = "Jouez droit les putts droits";
"tip.phantomBreak.body" = "%@ vous jouez une pente qui n'existe pas. Si vous ne voyez pas de pente nette, visez le milieu du trou et faites confiance à la lecture droite.";
"tip.uphillPace.title" = "Osez plus en montée";
"tip.uphillPace.body" = "%@ la balle reste courte. Imaginez une cible 30 à 50 cm derrière le trou et faites un mouvement arrière plus long pour elle.";
"tip.downhillPace.title" = "Plus de douceur en descente";
"tip.downhillPace.body" = "%@ la balle passe trop loin. Imaginez un trou un demi-mètre avant le vrai et laissez la balle y rouler.";
"tip.slopeOverRead.title" = "Ne surjouez pas la pente";
"tip.slopeOverRead.body" = "%@ vous jouez plus de pente qu'il n'y en a. Partez de la vitesse d'un putt plat de même longueur et n'ajustez que légèrement.";
"tip.dieAtHole.title" = "Amenez la balle au trou";
"tip.dieAtHole.body" = "%@ vos manqués restent courts. Jouez pour que la balle finisse 30 à 40 cm derrière le trou, court ne rentre jamais.";
"tip.softerPace.title" = "Enlevez un peu de vitesse";
"tip.softerPace.body" = "%@ vos manqués passent trop loin. Réglez la longueur par l'ampleur du mouvement arrière plutôt que par la frappe, et imaginez la balle qui meurt au bord du trou.";
"tip.startLineLeft.title" = "Ligne de départ : pas à gauche";
"tip.startLineLeft.body" = "%@ vos manqués partent à gauche. Choisissez un repère 30 cm devant la balle, alignez la face dessus et faites rouler la balle par-dessus.";
"tip.startLineRight.title" = "Ligne de départ : pas à droite";
"tip.startLineRight.body" = "%@ vos manqués partent à droite. Choisissez un repère 30 cm devant la balle, alignez la face dessus et faites rouler la balle par-dessus.";
"tip.pull.title" = "Arrêtez de tirer";
"tip.pull.body" = "%@ vous tirez le putt à gauche. Laissez les épaules mener le mouvement, gardez les poignets calmes et la tête baissée jusqu'après l'impact.";
"tip.push.title" = "Arrêtez de pousser";
"tip.push.body" = "%@ vous poussez le putt à droite. Laissez le putter passer librement à travers la balle au lieu de le diriger le long de la ligne, et gardez la face carrée.";
"tip.contact.title" = "Frappez proprement";
"tip.contact.body" = "%@ vous ne frappez pas la balle proprement. Placez la balle face au centre de la face et gardez le putter à la même hauteur pendant tout le mouvement.";
"tip.badStroke.title" = "Faites un mouvement plus calme";
"tip.badStroke.body" = "%@ le mouvement lui-même vous coûte des putts. Allez en arrière et en avant dans le même rythme et restez immobile au-dessus de la balle jusqu'après l'impact.";
"tip.readTime.title" = "Lisez plus soigneusement";
"tip.readTime.body" = "%@ vous vous trompez souvent de lecture. Lisez depuis l'arrière et depuis le côté bas avant de vous décider, puis tenez-vous-en à votre lecture.";
"tip.aim.title" = "Vérifiez votre visée";
"tip.aim.body" = "%@ vous visez souvent à côté. Pointez le trait de la balle vers votre cible et vérifiez-le depuis l'arrière avant de vous installer.";
"tip.holedLess.title" = "Prenez plus de temps dans ces conditions";
"tip.holedLess.body" = "%@ vous rentrez nettement moins de putts. Prenez votre temps pour la lecture et votre routine, et ne vous précipitez pas.";
"tip.lag.title" = "Approchez les longs putts";
"tip.lag.body" = "%@ vous faites plus souvent trois putts. Sur le premier putt, la longueur compte plus que la ligne, visez un cercle d'un mètre autour du trou.";
"tip.lagDistance.title" = "Travaillez l'approche";
"tip.lagDistance.body" = "%@ trop de putts finissent à plus d'un mètre du trou. Sur le premier putt, mettez l'accent sur la longueur et visez un cercle d'un mètre autour du trou.";
