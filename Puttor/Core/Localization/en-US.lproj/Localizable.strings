"tip.moreBreak.title" = "Play more break";
"tip.moreBreak.body" = "%@ the ball stays below the hole too often. Pick the high point of the line and, when in doubt, play more break — from above, the ball can still fall.";
"tip.lessBreak.title" = "Play less break";
"tip.lessBreak.body" = "%@ the ball keeps missing above the hole. Play a tighter line with enough pace that the ball does not take all of the break.";
"tip.phantomBreak.title" = "Play straight putts straight";
"tip.phantomBreak.body" = "%@ you play break that is not there. If you cannot see a clear break, aim at the middle of the cup and trust the straight read.";
"tip.uphillPace.title" = "Be bolder uphill";
"tip.uphillPace.body" = "%@ the ball comes up short. Picture a target 30 to 50 cm past the hole and make a longer backswing for it.";
"tip.downhillPace.title" = "Be gentler downhill";
"tip.downhillPace.body" = "%@ the ball runs too far. Picture a hole half a meter short of the real one and let the ball roll into it.";
"tip.slopeOverRead.title" = "Don't overplay the slope";
"tip.slopeOverRead.body" = "%@ you play more slope than there is. Start from the pace of a flat putt of the same length and adjust only a little.";
"tip.dieAtHole.title" = "Get the ball to the hole";
"tip.dieAtHole.body" = "%@ your misses come up short. Play for the ball to finish 30 to 40 cm past the hole — short never goes in.";
"tip.softerPace.title" = "Take some pace off";
"tip.softerPace.body" = "%@ your misses run too far. Control length with the length of the backswing rather than the hit, and picture the ball dying at the edge of the cup.";
"tip.startLineLeft.title" = "Start line: not left";
"tip.startLineLeft.body" = "%@ your misses go left. Pick a spot 30 cm in front of the ball, square the face to it and roll the ball over it.";
"tip.startLineRight.title" = "Start line: not right";
"tip.startLineRight.body" = "%@ your misses go right. Pick a spot 30 cm in front of the ball, square the face to it and roll the ball over it.";
"tip.pull.title" = "Stop the pull";
"tip.pull.body" = "%@ you pull the putt left. Let the shoulders lead the stroke, keep the wrists quiet and your head down until after impact.";
"tip.push.title" = "Stop the push";
"tip.push.body" = "%@ you push the putt right. Let the putter swing freely through the ball instead of steering it down the line, and keep the face square.";
"tip.contact.title" = "Strike it cleanly";
"tip.contact.body" = "%@ you do not strike the ball cleanly. Set the ball opposite the center of the face and keep the putter at the same height through the whole stroke.";
"tip.badStroke.title" = "Make a calmer stroke";
"tip.badStroke.body" = "%@ the stroke itself costs you putts. Swing back and through in the same rhythm and stay still over the ball until after impact.";
"tip.readTime.title" = "Read more carefully";
"tip.readTime.body" = "%@ you misread a lot of putts. Read them from behind and from the low side before you commit — then stick with your read.";
"tip.aim.title" = "Check your aim";
"tip.aim.body" = "%@ you often aim off line. Point the line on the ball at your target and check it from behind before you set up.";
"tip.holedLess.title" = "Take more time in these conditions";
"tip.holedLess.body" = "%@ you hole clearly fewer putts. Take your time over the read and your routine, and do not rush.";
"tip.lag.title" = "Lag long putts close";
"tip.lag.body" = "%@ you three-putt more often. On the first putt, length matters more than line — aim for a one-meter circle around the hole.";
"tip.lagDistance.title" = "Work on lag putting";
"tip.lagDistance.body" = "%@ too many putts finish more than a meter from the hole. On the first putt, put the focus on length and aim for a one-meter circle around the hole.";
